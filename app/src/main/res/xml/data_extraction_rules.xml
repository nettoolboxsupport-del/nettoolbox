<?xml version="1.0" encoding="utf-8"?>
<!-- No cloud backup and no device-transfer of measurement data (spec section 9). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude
            domain="root"
            path="." />
    </cloud-backup>
    <device-transfer>
        <exclude
            domain="root"
            path="." />
    </device-transfer>
</data-extraction-rules>
