    <string name="iperf3_running">Measuring… %1$d s</string>
    <string name="iperf3_no_cancel_note">A running test cannot be interrupted: libiperf offers no way to abort one. That is why only short durations are offered.</string>
    <string name="iperf3_sent">Sent</string>
    <string name="iperf3_received">Received</string>
    <string name="iperf3_retransmits">Retransmits</string>
